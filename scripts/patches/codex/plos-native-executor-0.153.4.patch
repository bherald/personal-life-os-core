+    for result in [rendered.executor, rendered.orchestrator, rendered.host] {
+        let result = result.expect("complete catalog");
+        assert_eq!(result.report.omitted_count, 0);
+        assert_eq!(result.report.truncated_description_chars, 0);
+        let fragment = result.into_fragment(false).expect("complete fragment");
+        assert!(fragment.body().contains(&description));
+        assert!(!fragment.body().contains("short substitute"));
+    }
+}
