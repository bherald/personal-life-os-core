+#[test]
+fn plos_preservation_keeps_binary_bytes_across_drains_and_merges() {
+    let expected: Vec<u8> = (0..=255).cycle().take(8193).collect();
+    let mut producer = HeadTailBuffer::<10>::with_preservation(/*preserve_all*/ true);
+    let mut collected = HeadTailBuffer::<10>::with_preservation(/*preserve_all*/ true);
+    for chunk in expected.chunks(127) {
+        producer.push_chunk(chunk);
+        collected.push_buffer(producer.take());
+        assert!(producer.preserves_all());
+        assert_eq!(producer.retained_bytes(), 0);
+    }
+    assert_eq!(collected.to_bytes_with_omission_marker(), expected);
+    assert_eq!(collected.omitted_bytes(), 0);
+    assert_eq!(collected.total_bytes(), expected.len());
+}
