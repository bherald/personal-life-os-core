+    transcript.lock().await.push_chunk(complete);
+    let mut output = Buffer::<8> {
+        pending: Vec::new(),
+        transcript: Arc::clone(&transcript),
+        record_transcript: false,
+        emitter: Emitter {
+            remaining_deltas: 0,
+            session,
+            turn,
+            call_id: "plos-preserved-output".to_string(),
+        },
+    };
+    // A late or lagging subscriber may see only part of the stream.
+    output.push(b"with all original bytes".to_vec()).await;
+    output.finish().await;
+    assert_eq!(
+        transcript.lock().await.to_bytes_with_omission_marker(),
+        complete
+    );
+}
