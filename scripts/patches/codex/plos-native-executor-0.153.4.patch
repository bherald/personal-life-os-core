+#[tokio::test]
+async fn plos_producer_transcript_survives_polling_without_a_stream_subscriber() {
+    let transcript = Arc::new(tokio::sync::Mutex::new(
+        HeadTailBuffer::<10>::with_preservation(/*preserve_all*/ true),
+    ));
+    let output = OutputHandles {
+        output_buffer: Arc::new(tokio::sync::Mutex::new(
+            HeadTailBuffer::<10>::with_preservation(/*preserve_all*/ true),
+        )),
+        preserved_transcript: Some(Arc::clone(&transcript)),
+        output_notify: Arc::new(Notify::new()),
+        output_closed: Arc::new(AtomicBool::new(false)),
+        output_closed_notify: Arc::new(Notify::new()),
+        cancellation_token: CancellationToken::new(),
+    };
+    let first = b"first\0\xff output beyond the buffer cap";
+    let second = b"second\0\xfe output beyond the buffer cap";
+    output.record_output(first).await;
+    let initial = UnifiedExecProcessManager::collect_output_until_deadline(
+        &output,
+        /*pause_state*/ None,
+        Instant::now() + Duration::from_millis(10),
+    )
+    .await;
+    assert_eq!(initial.to_bytes_with_omission_marker(), first);
+    output.record_output(second).await;
+    output.output_closed.store(true, Ordering::Release);
+    output.cancellation_token.cancel();
+    let later = UnifiedExecProcessManager::collect_output_until_deadline(
+        &output,
+        /*pause_state*/ None,
+        Instant::now() + Duration::from_millis(10),
+    )
+    .await;
+    assert_eq!(later.to_bytes_with_omission_marker(), second);
+    assert_eq!(
+        transcript.lock().await.to_bytes_with_omission_marker(),
+        [first.as_slice(), second.as_slice()].concat()
+    );
+}
