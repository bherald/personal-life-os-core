+#[test]
+fn plos_unbounded_catalog_preserves_complete_descriptions_across_all_authorities() {
+    let description = format!("  {} exact catalog tail  ", "José 日本語 ".repeat(500));
+    let catalog = SkillCatalog {
+        entries: vec![entry("full-skill", &description, Some("short substitute"))],
+        warnings: Vec::new(),
