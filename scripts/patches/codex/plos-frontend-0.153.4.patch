+#[derive(Clone, Debug, PartialEq, Eq, serde::Deserialize)]
+pub(crate) struct PlosCommand {
+    pub name: String,
+    pub description: String,
+    pub usage: String,
+    pub detail: String,
+    #[serde(default)]
+    pub disabled: bool,
+}
+
+static PLOS_COMMANDS: std::sync::RwLock<(u64, Vec<PlosCommand>)> = std::sync::RwLock::new((0, Vec::new()));
+pub(crate) fn begin_plos_command_refresh() -> u64 {
+    let mut state = PLOS_COMMANDS.write().unwrap_or_else(|e| e.into_inner());
+    state.0 += 1;
+    state.1.clear();
+    state.0
+}
+pub(crate) fn set_plos_commands(generation: u64, commands: Vec<PlosCommand>) {
+    let mut state = PLOS_COMMANDS.write().unwrap_or_else(|e| e.into_inner());
+    if state.0 == generation { state.1 = commands; }
+}
+pub(crate) fn plos_commands() -> Vec<PlosCommand> {
+    let mut commands = PLOS_COMMANDS.read().unwrap_or_else(|e| e.into_inner()).1.clone();
+    for (name, _) in built_in_slash_commands() {
+        if !commands.iter().any(|command| command.name == name) {
+            commands.push(PlosCommand { name: name.to_string(), usage: String::new(), disabled: true,
+                description: "Unavailable: no PLOS command binding loaded".to_string(),
+                detail: "This native command has no PLOS binding in the current catalog. Use /help for implemented commands.".to_string() });
+        }
+    }
+    commands
+}
+
