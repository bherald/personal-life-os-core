{
  "name": "plos-workflow-mcp-server",
  "version": "1.0.0",
  "description": "MCP server for the PLOS workflow framework",
  "type": "module",
  "main": "dist/index.js",
  "engines": {
    "node": ">=22.12 <25",
    "npm": ">=10.9"
  },
  "overrides": {
    "ip-address": "10.7.2",
    "proxy-addr": "2.0.8"
  },
  "scripts": {
