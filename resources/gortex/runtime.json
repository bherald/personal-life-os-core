{
  "version": "v0.64.5",
  "source_commit": "33107203de4900f1229a3eeff631ff9802c6725a",
  "binary_sha256": "0bd0fefd99e6f8316d7e43d5f000bd7009eb3295338c731feef9bf410cba5f74",
  "archive_sha256": "84c653ad065892b4e648a0b4b22d8a21c88dbe23e8e80691aaa4a8a38df31b3b",
  "private_directory": "storage/app/private/gortex",
  "tools": [
    {
      "name": "search_symbols",
      "description": "Find PHP, TypeScript, SQL and other indexed symbols.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "query": {
            "type": "string"
          },
          "repo": {
            "type": "string"
          },
          "corpus": {
            "type": "string",
            "enum": [
              "code",
              "docs",
              "all"
            ]
          }
        },
        "required": [
          "query"
        ]
      }
    },
    {
      "name": "get_symbol",
      "description": "Read metadata for an indexed symbol.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          }
        },
        "required": [
          "id"
        ]
      }
    },
    {
      "name": "get_symbol_source",
      "description": "Read the exact complete source of an indexed symbol.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "context_lines": {
            "type": "integer",
            "minimum": 0,
            "maximum": 20
          }
        },
        "required": [
          "id"
        ]
      }
    },
    {
      "name": "get_callers",
      "description": "Find evidence-backed callers; missing edges do not prove absence.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "depth": {
            "type": "integer",
            "minimum": 1,
            "maximum": 3
          },
          "repo": {
            "type": "string"
          }
        },
        "required": [
          "id"
        ]
      }
    },
    {
      "name": "find_files",
      "description": "Find indexed source files by name or glob.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "query": {
            "type": "string"
          },
          "glob": {
            "type": "string"
          },
          "repo": {
            "type": "string"
          }
        },
        "required": []
      }
    },
    {
      "name": "get_dependencies",
      "description": "Find dependencies of an indexed symbol.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "repo": {
            "type": "string"
          }
        },
        "required": [
          "id"
        ]
      }
    }
  ]
}
